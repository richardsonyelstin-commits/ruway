---
/**
 * Footer — cierre del sitio.
 *
 * Accesibilidad:
 *  - <footer role="contentinfo"> implícito = landmark de contenido
 *  - cada columna es un <nav> con aria-label propio → se puede saltar entre
 *    grupos de enlaces desde un lector de pantalla (WCAG 1.3.1 · 2.4.1)
 *  - la dirección usa <address>, el elemento semántico correcto
 *  - los enlaces tienen texto descriptivo: nunca «clic aquí»
 *  - el aviso del certificado se comunica con texto, no con color (1.4.1)
 */
import { NAV_PIE, NAV_SECUNDARIA } from '../data/navegacion';
import { SITIO, DIRECCION_UNA_LINEA, ENLACE_MAPA } from '../data/site';
import { MENSAJES, enlaceWhatsApp } from '../lib/whatsapp';
import Marca from './Marca.astro';
import Pendiente from './Pendiente.astro';

const anio = new Date().getFullYear();
---

<footer class="border-t border-borde bg-superficie">
  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <!-- Identidad -->
      <div class="space-y-4">
        <Marca alto={36} alt={`${SITIO.nombre} · ${SITIO.descriptor}`} />
        <p class="max-w-xs text-pequeno text-texto-suave">
          Academia presencial de inteligencia artificial en Cajamarca.
          Grupos pequeños, proyectos reales y acompañamiento paso a paso.
        </p>
      </div>

      <!-- Columnas de navegación -->
      {
        NAV_PIE.map((columna) => (
          <nav aria-label={columna.titulo}>
            <h2 class="font-display text-titulo-3">{columna.titulo}</h2>
            <ul class="mt-3 flex list-none flex-col gap-2 p-0">
              {columna.enlaces.map((enlace) => (
                <li>
                  <a
                    href={enlace.href}
                    class="text-pequeno text-texto no-underline hover:underline"
                  >
                    {enlace.etiqueta}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <!-- Contacto -->
    <div class="mt-12 grid gap-8 border-t border-borde pt-8 md:grid-cols-2">
      <nav aria-label="Contacto y ubicación">
        <h2 class="font-display text-titulo-3">Cómo llegar y escribir</h2>
        <address class="mt-3 space-y-2 not-italic text-pequeno text-texto-suave">
          <p>
            <a
              class="text-texto"
              href={enlaceWhatsApp(MENSAJES.consulta)}
              rel="noopener noreferrer"
              target="_blank"
            >
              {`WhatsApp ${SITIO.contacto.whatsapp.visible}`}
            </a>
          </p>
          <p>
            <a class="text-texto" href={`mailto:${SITIO.contacto.correo}`}>
              {SITIO.contacto.correo}
            </a>
          </p>
          <p>
            <a class="text-texto" href={ENLACE_MAPA} rel="noopener noreferrer" target="_blank">
              {DIRECCION_UNA_LINEA}
            </a>
          </p>
          <p>
            Atención presencial:{' '}
            {
              SITIO.sede.horarioAtencion === '[POR DEFINIR]' ? (
                <Pendiente descripcion="Horario de atención presencial" />
              ) : (
                SITIO.sede.horarioAtencion
              )
            }
          </p>
        </address>
      </nav>

      <nav aria-label="Enlaces del sitio">
        <h2 class="font-display text-titulo-3">Navegación</h2>
        <ul class="mt-3 flex list-none flex-wrap gap-x-6 gap-y-2 p-0">
          {
            NAV_SECUNDARIA.map((enlace) => (
              <li>
                <a href={enlace.href} class="text-pequeno text-texto no-underline hover:underline">
                  {enlace.etiqueta}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- Barra inferior -->
    <div class="mt-12 flex flex-col gap-3 border-t border-borde pt-6 text-micro text-texto-suave">
      <p>© {anio} {SITIO.nombre} · {SITIO.sede.distrito}, {SITIO.sede.pais}</p>
      <p class="max-w-3xl">
        <strong class="font-semibold">Certificado de participación sin validez oficial del
          MINEDU.</strong> Acredita 48 horas de formación práctica y un proyecto final.
      </p>
      <p>Los precios publicados incluyen IGV.</p>
    </div>
  </div>
</footer>
