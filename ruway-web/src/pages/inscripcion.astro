---
/**
 * /inscripcion — el único formulario del sitio (ADR-004).
 *
 * Anclas del sitemap §8: `#requisitos` · `#formulario` · `#despues`.
 *
 * ORDEN DE LA PÁGINA, Y POR QUÉ
 *   Los requisitos van ANTES del formulario. Es lo que pide WCAG 2.2 · 3.3.2
 *   («etiquetas o instrucciones»): quien va a rellenar un campo tiene que saber
 *   antes qué hace falta para entrar, no descubrirlo después. Y no es solo por
 *   la norma: si alguien no tiene laptop propia, es mejor que lo lea aquí que
 *   después de haber reservado una plaza.
 *
 *   `#despues` va al final porque responde a la pregunta que sigue al envío
 *   («¿y ahora qué?») y también porque da a la página un cierre natural: aquí
 *   no hay banda de conversión, la conversión es la página entera.
 */
import PlantillaPagina from '../layouts/PlantillaPagina.astro';
import Seccion from '../components/Seccion.astro';
import Formulario from '../components/Formulario.astro';
import Icono from '../components/Icono.astro';
import { conInicio } from '../lib/migajas';
import { SITIO } from '../data/site';
import { CONDICION_LANZAMIENTO, TRAMOS, soles } from '../data/precios';
import { NOTAS_REQUISITOS, REQUISITOS_INGRESO, SEDE } from '../data/programa';
import { ENLACE_CONSULTA, ENLACE_DEMO } from '../lib/whatsapp';

const migajas = conInicio({ etiqueta: 'Inscripción', href: '/inscripcion' });

const titulo = 'Inscripción y clase demo gratis · IA en Cajamarca';
const descripcion =
  'Reserva una clase demo gratuita o tu plaza del Ciclo 1 del Programa de IA Aplicada en Cajamarca. Grupos de 7 a 10 alumnos, 8 semanas, presencial.';

/** El paso a paso posterior al envío. Es la respuesta a «¿y ahora qué?». */
const PASOS = [
  {
    titulo: 'Te respondemos por WhatsApp',
    texto:
      'Contesta la persona que dicta las clases, normalmente el mismo día. Si escribes fuera del horario de clases, te respondemos al día siguiente.',
  },
  {
    titulo: 'Coordinamos la demo o la matrícula',
    texto:
      'Si pediste la demo, acordamos un día y una hora para que vengas al aula. Si pediste matrícula, te pasamos los pasos y el medio de pago.',
  },
  {
    titulo: 'Antes de la primera clase se firma',
    texto:
      'El contrato de matrícula, el reglamento interno y, si el alumno es menor de 18 años, la autorización del apoderado. Nada se firma antes de esa conversación.',
  },
];

const grupoEscolar = TRAMOS.find((t) => t.clave === 'escolar');
const grupoGeneral = TRAMOS.find((t) => t.clave === 'general');
---

<PlantillaPagina
  titulo={titulo}
  descripcion={descripcion}
  eyebrow="Inscripción"
  h1="Reserva tu clase demo o tu plaza"
  entrada={`Un solo formulario para las dos cosas. Elige la opción, revisa el mensaje y se abrirá WhatsApp con todo escrito. Próximo inicio del Ciclo 1: ${SITIO.ciclo1.inicioTextoCompleto}.`}
  migajas={migajas}
>
  {/* ───────────────────────────── Requisitos ───────────────────────────── */}
  <Seccion
    id="requisitos"
    eyebrow="Antes de empezar"
    titulo="Qué necesitas para entrar"
    entrada="Son cuatro cosas, y ninguna es un examen de admisión. Si algo de esto no lo tienes claro, pregúntanos antes de inscribirte."
  >
    <ul class="grid list-none gap-3 p-0 sm:grid-cols-2">
      {
        REQUISITOS_INGRESO.map((requisito) => (
          <li class="flex items-start gap-3 rounded-marca border border-borde bg-superficie px-5 py-4">
            <span class="mt-1 shrink-0 text-exito">
              <Icono nombre="comprobado" clase="size-4" grosor={2.8} />
            </span>
            <span class="text-cuerpo text-texto">{requisito}</span>
          </li>
        ))
      }
    </ul>

    <div class="mt-6 rounded-marca border border-borde bg-superficie p-6">
      <h3 class="flex items-center gap-2.5 font-display text-titulo-3">
        <span class="text-acento"><Icono nombre="escudo" clase="size-5" grosor={1.5} /></span>
        Tres cosas que conviene saber de frente
      </h3>
      <ul class="mt-3 list-none space-y-2 p-0 text-pequeno text-pretty text-texto-suave">
        {
          NOTAS_REQUISITOS.map((nota) => (
            <li class="flex items-start gap-3">
              <span class="mt-1.5 shrink-0 text-acento">
                <Icono nombre="chevron" clase="size-3.5" grosor={2.6} />
              </span>
              {nota}
            </li>
          ))
        }
      </ul>
      <p class="mt-4 border-t border-borde pt-4 text-pequeno text-texto-suave">
        Las clases son en {SEDE.calle}, {SEDE.ciudad}, {SEDE.horario.toLowerCase()} de{' '}
        <span class="dato">{SEDE.horarioDetalle}</span>.
      </p>
    </div>

    <p class="mt-6 text-pequeno text-texto-suave">
      La clase demo no exige nada de esta lista: es para conocer el método, el local y a quien dicta
      las clases. <a href="/programa">Ver el programa completo</a>.
    </p>
  </Seccion>

  {/* ───────────────────────────── Formulario ───────────────────────────── */}
  <Seccion
    id="formulario"
    tono="superficie"
    eyebrow="La inscripción"
    titulo="Clase demo o matrícula: un solo formulario"
    entrada="Los dos caminos empiezan igual. La diferencia está en lo que quieres hacer ahora, no en lo que tienes que escribir."
  >
    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
      <Formulario
        prefijo="inscripcion"
        titulo="Cuéntanos quién eres y te escribimos"
      />

      <aside class="rounded-marca border border-borde bg-fondo p-6">
        <h3 class="font-display text-titulo-3">Datos del Ciclo 1</h3>
        <dl class="mt-4 space-y-3 text-pequeno">
          <div>
            <dt class="font-mono text-micro tracking-[0.14em] text-texto-suave uppercase">Inicio</dt>
            <dd class="mt-0.5 text-texto">{SITIO.ciclo1.inicioTextoCompleto}</dd>
          </div>
          <div>
            <dt class="font-mono text-micro tracking-[0.14em] text-texto-suave uppercase">Duración</dt>
            <dd class="mt-0.5 text-texto">8 semanas · 24 sesiones · 48 horas</dd>
          </div>
          <div>
            <dt class="font-mono text-micro tracking-[0.14em] text-texto-suave uppercase">Grupo</dt>
            <dd class="mt-0.5 text-texto">Mínimo 7 y máximo 10 alumnos</dd>
          </div>
          {grupoGeneral && grupoEscolar && (
            <div>
              <dt class="font-mono text-micro tracking-[0.14em] text-texto-suave uppercase">
                Inversión
              </dt>
              <dd class="mt-0.5 text-texto">
                <span class="dato font-semibold">{soles(grupoGeneral.lanzamiento)}</span> general ·{' '}
                <span class="dato font-semibold">{soles(grupoEscolar.lanzamiento)}</span> escolares
              </dd>
            </div>
          )}
        </dl>
        <p class="mt-4 border-t border-borde pt-4 text-pequeno text-texto-suave">
          {CONDICION_LANZAMIENTO} <a href="/precios">Ver precios y devoluciones</a>.
        </p>
        <p class="mt-4 text-pequeno">
          ¿Prefieres no llenar nada?{' '}
          <a href={ENLACE_DEMO} rel="noopener noreferrer" target="_blank">
            Escríbenos por WhatsApp
          </a>{' '}
          al <span class="dato">{SITIO.contacto.whatsapp.visible}</span>.
        </p>
      </aside>
    </div>
  </Seccion>

  {/* ─────────────────────────────── Después ─────────────────────────────── */}
  <Seccion
    id="despues"
    eyebrow="Después de enviar"
    titulo="Qué pasa con tu mensaje"
    entrada="Este sitio no guarda tus datos: el mensaje sale de tu dispositivo y llega a nuestro WhatsApp. Esto es lo que ocurre a partir de ahí."
  >
    <ol class="list-none space-y-4 p-0">
      {
        PASOS.map((paso, indice) => (
          <li class="flex items-start gap-4">
            <span
              class="dato mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-maiz font-semibold text-sobre-cta"
              aria-hidden="true"
            >
              {indice + 1}
            </span>
            <div>
              <h3 class="font-display text-cuerpo">{paso.titulo}</h3>
              <p class="mt-1 text-pequeno text-pretty text-texto-suave">{paso.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-8 rounded-marca border border-borde bg-superficie p-6">
      <h3 class="font-display text-titulo-3">Una advertencia honesta</h3>
      <p class="mt-2 text-pequeno text-pretty text-texto-suave">
        El grupo abre con un mínimo de 7 alumnos. Si no se llega a ese número, te avisamos antes de
        la fecha de inicio y devolvemos el 100 % de lo pagado, sin trámite. Está escrito en el
        contrato.
      </p>
      <p class="mt-4 text-pequeno text-texto-suave">
        No pedimos documentos por WhatsApp ni por correo antes de la matrícula. Si recibes un mensaje
        que te los pide en nuestro nombre, no es nuestro.{' '}
        <a href="/privacidad">Cómo tratamos tus datos</a>.
      </p>
      <p class="mt-4 border-t border-borde pt-4 text-pequeno text-texto-suave">
        ¿Te quedó una duda antes de inscribirte?{' '}
        <a href={ENLACE_CONSULTA} rel="noopener noreferrer" target="_blank">
          Pregúntanos por WhatsApp
        </a>{' '}
        o revisa las <a href="/preguntas-frecuentes">preguntas frecuentes</a>.
      </p>
    </div>
  </Seccion>
</PlantillaPagina>
