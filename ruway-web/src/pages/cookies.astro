---
/**
 * /cookies — la página más corta de explicar del sitio: no hay cookies.
 *
 * ADR-010 decidió una analítica sin cookies y sin banner. Esta página es la
 * consecuencia de esa decisión: en lugar de un aviso que pide permiso, hay una
 * explicación de por qué no hace falta pedirlo.
 *
 * Contenido en `src/data/legal.ts` (secciones `SECCIONES_COOKIES`).
 */
import PlantillaPagina from '../layouts/PlantillaPagina.astro';
import ContenidoLegal from '../components/ContenidoLegal.astro';
import Retorno from '../components/Retorno.astro';
import { conInicio } from '../lib/migajas';
import { ACTUALIZADO, SECCIONES_COOKIES } from '../data/legal';

const migajas = conInicio({ etiqueta: 'Cookies', href: '/cookies' });

const titulo = 'Política de cookies: este sitio no usa cookies';
const descripcion =
  'Este sitio no usa cookies: ni propias ni de terceros. Explicamos por qué, lo único que guardamos en tu navegador y cómo medimos sin rastrear.';
---

<PlantillaPagina
  titulo={titulo}
  descripcion={descripcion}
  eyebrow="Legal"
  h1="Cookies: aquí no hay ninguna"
  entrada="Ni propias, ni de terceros, ni de analítica. Por eso no vas a encontrar un banner pidiéndote que aceptes algo que no ocurre."
  migajas={migajas}
>
  <div class="mx-auto max-w-6xl px-5 py-12 md:py-16">
    <p class="font-mono text-micro tracking-[0.14em] text-texto-suave uppercase">
      Última actualización: {ACTUALIZADO}
    </p>
    <div class="mt-8">
      <ContenidoLegal secciones={SECCIONES_COOKIES} />
    </div>
  </div>

  <Retorno />
</PlantillaPagina>
