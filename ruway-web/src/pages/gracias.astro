---
/**
 * /gracias — confirmación del envío (sitemap §4, página 5).
 *
 * `noindex, follow`: no aporta nada a un buscador y no queremos que alguien
 * caiga aquí desde Google sin haber enviado nada. Ya está excluida del sitemap
 * (`astro.config.mjs`) y del rastreo (`public/robots.txt`).
 *
 * POR QUÉ EXISTE ESTA PÁGINA
 *   ADR-022: al confirmar el formulario, WhatsApp se abre en otra pestaña y esta
 *   pestaña pasa a /gracias. Así la persona que envió el mensaje encuentra una
 *   confirmación real —y sabe que falta pulsar «enviar» dentro de WhatsApp—
 *   en lugar de volver a un formulario que ya rellenó. Además, cuando se active
 *   la medición sin cookies (ADR-010), la visita a esta URL es el evento de
 *   conversión.
 *
 *   Es la única página del sitio que no pide nada y no vende nada: llega
 *   alguien que ya hizo lo que tenía que hacer. Su trabajo es cerrar el círculo.
 *
 * SOBRE EL BOTÓN DE WHATSAPP
 *   El mensaje no se puede reconstruir aquí: viajó en el enlace de la pestaña
 *   anterior y no se guarda en ningún sitio (ese es justamente el trato). Por eso
 *   el botón abre una conversación nueva y se dice tal cual, sin prometer que
 *   recupera el texto. En el caso normal no hace falta: WhatsApp ya está abierto.
 */
import PlantillaPagina from '../layouts/PlantillaPagina.astro';
import Icono from '../components/Icono.astro';
import { conInicio } from '../lib/migajas';
import { SITIO } from '../data/site';
import { ENLACE_CONSULTA } from '../lib/whatsapp';

const migajas = conInicio({ etiqueta: 'Envío completado', href: '/gracias' });

const titulo = 'Tu mensaje salió del sitio';
const descripcion =
  'Se abrió WhatsApp con tus datos escritos. Falta un paso: pulsar enviar allí. Esto es lo que ocurre después.';

const PASOS = [
  {
    titulo: 'Pulsa enviar en WhatsApp',
    texto:
      'El mensaje está escrito con tus datos. Se envía cuando lo mandas tú: este sitio no lo envía por su cuenta.',
  },
  {
    titulo: 'Te respondemos',
    texto: `Contesta la persona que dicta las clases, al número ${SITIO.contacto.whatsapp.visible}. Si escribes fuera del horario de clases, al día siguiente.`,
  },
  {
    titulo: 'Acordamos el siguiente paso',
    texto: `Una fecha para la clase demo, o los pasos de la matrícula del Ciclo 1, que empieza el ${SITIO.ciclo1.inicioTextoCompleto}.`,
  },
];
---

<PlantillaPagina
  titulo={titulo}
  descripcion={descripcion}
  eyebrow="Envío completado"
  h1="Tu mensaje salió del sitio"
  entrada="Se abrió WhatsApp con tus datos ya escritos. Este sitio no guarda nada: el mensaje vive en tu conversación, no en un servidor nuestro."
  migajas={migajas}
  noindex
>
  <section aria-labelledby="siguiente-titulo">
    <div class="mx-auto max-w-6xl px-5 py-14 md:py-20">
      <header class="max-w-2xl">
        <p class="font-mono text-micro tracking-[0.18em] text-acento uppercase">Qué sigue</p>
        <h2 id="siguiente-titulo" class="mt-3 font-display text-titulo-2 text-balance">
          Tres pasos, y el primero es tuyo
        </h2>
      </header>

      <ol class="mt-10 list-none space-y-4 p-0">
        {
          PASOS.map((paso, indice) => (
            <li class="flex items-start gap-4 rounded-marca border border-borde bg-superficie px-5 py-4">
              <span
                class="dato mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-maiz font-semibold text-sobre-cta"
                aria-hidden="true"
              >
                {indice + 1}
              </span>
              <div>
                <h3 class="font-display text-cuerpo">{paso.titulo}</h3>
                <p class="mt-1 text-pequeno text-pretty text-texto-suave">{paso.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="mt-8 rounded-marca border border-borde bg-superficie p-6">
        <h3 class="font-display text-titulo-3">¿No se abrió WhatsApp?</h3>
        <p class="mt-2 text-pequeno text-pretty text-texto-suave">
          A veces el navegador bloquea la pestaña nueva. Ábrelo a mano: el texto que revisaste no se
          recupera —no se guardó en ningún sitio—, así que escríbenos y lo vemos juntos.
        </p>
        <p class="mt-4 flex flex-wrap gap-3">
          <a
            href={ENLACE_CONSULTA}
            rel="noopener noreferrer"
            target="_blank"
            class="inline-flex min-h-11 items-center justify-center gap-2.5 rounded-full bg-maiz px-6 py-3 font-semibold text-sobre-cta no-underline transition-colors duration-150 hover:bg-maiz/90"
          >
            <Icono nombre="mensaje" clase="size-5" grosor={1.8} />
            Abrir WhatsApp
          </a>
          <a
            href={`mailto:${SITIO.contacto.correo}`}
            class="inline-flex min-h-11 items-center justify-center rounded-full border-2 border-borde-control px-6 py-3 font-semibold text-texto no-underline transition-colors duration-150 hover:border-acento hover:text-acento"
          >
            Escribir por correo
          </a>
        </p>
      </div>

      <div class="mt-8 border-t border-borde pt-8">
        <h2 class="font-display text-titulo-3">Mientras esperas</h2>
        <ul class="mt-3 list-none space-y-2 p-0 text-pequeno">
          <li>
            <a href="/programa">Repasa el temario de las 8 semanas</a>
          </li>
          <li>
            <a href="/precios">Mira los precios, los descuentos y la política de devoluciones</a>
          </li>
          <li>
            <a href="/preguntas-frecuentes">Las dudas que más nos escriben</a>
          </li>
          <li>
            <a href="/">Volver al inicio</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</PlantillaPagina>
